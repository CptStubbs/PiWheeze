# Bcrypt hash of the dashboard login password (username: piwheeze).
# Generate with:
#   docker run --rm caddy:2-alpine caddy hash-password
# Then copy this file to .env and replace the value below.
DASHBOARD_PASSWORD_HASH=$2a$14$REPLACE_ME

# Secret key used to sign the "stay logged in" cookie. Keep this private and
# stable across restarts (rotating it logs everyone out). Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_COOKIE_KEY=REPLACE_ME
